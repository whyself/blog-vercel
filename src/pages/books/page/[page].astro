---
import ArchivePageDocument from '../../../components/ArchivePageDocument.astro';
import { ARCHIVE_PAGE_SIZE, buildArchiveStaticPaths, getArchiveData, getArchiveSeo, type ArchiveCardData } from '../../../utils/archive';
import { buildSearchItems } from '../../../utils/posts';

export async function getStaticPaths() {
  const base = import.meta.env.BASE_URL;
  const { cards } = await getArchiveData('books', base);
  return buildArchiveStaticPaths(cards, ARCHIVE_PAGE_SIZE);
}

const { currentPage, totalPages, cards } = Astro.props as {
  currentPage: number;
  totalPages: number;
  cards: ArchiveCardData[];
};

const base = import.meta.env.BASE_URL;
const { allPosts, allMoments } = await getArchiveData('books', base);
const searchPosts = buildSearchItems(allPosts, base);
const siteOrigin = Astro.site?.toString() ?? 'http://127.0.0.1:4321';
const { seoTitle, seoDescription, canonicalUrl, ogImageUrl } = getArchiveSeo('books', currentPage, base, siteOrigin);
---
<ArchivePageDocument
  base={base}
  cards={cards}
  searchItems={searchPosts}
  currentPage={currentPage}
  totalPages={totalPages}
  momentsCount={allMoments.length}
  route="books"
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  canonicalUrl={canonicalUrl}
  ogImageUrl={ogImageUrl}
/>
