---
import ArchiveMain from './ArchiveMain.astro';
import PageHead from './PageHead.astro';
import type { ArchiveCardData, ArchiveRoute } from '../utils/archive';
import type { SearchItem } from '../utils/posts';

interface Props {
  base: string;
  cards: ArchiveCardData[];
  searchItems: SearchItem[];
  currentPage: number;
  totalPages: number;
  route: ArchiveRoute;
  seoTitle: string;
  seoDescription: string;
  canonicalUrl: string;
  ogImageUrl: string;
}

const {
  base,
  cards,
  searchItems,
  currentPage,
  totalPages,
  route,
  seoTitle,
  seoDescription,
  canonicalUrl,
  ogImageUrl,
} = Astro.props as Props;
---
<!DOCTYPE html>
<html class="light" lang="en">
<head>
<PageHead
  base={base}
  title={seoTitle}
  description={seoDescription}
  canonicalUrl={canonicalUrl}
  ogType="website"
  ogImageUrl={ogImageUrl}
  twitterCard="summary_large_image"
/>
<style>
        body { font-family: 'Inter', sans-serif; }
        .serif-text { font-family: 'Newsreader', serif; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
    </style>
</head>
<ArchiveMain
  cards={cards}
  searchItems={searchItems}
  base={base}
  currentPage={currentPage}
  totalPages={totalPages}
  route={route}
/>
</html>
