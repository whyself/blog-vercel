---
import type { PostCardData } from '../utils/archive';

interface Props {
  card: PostCardData;
}

const { card } = Astro.props as Props;
const tagData = card.tags.join('||');
---

<article
  class="group cursor-pointer"
  data-post-card
  data-list-date={card.listDate}
  data-tags={tagData}
  data-word-count={card.wordCount}
>
  {card.thumbnail ? (
    <div class="flex flex-col md:flex-row md:items-start gap-8">
      <div class="flex-1 space-y-4 order-2 md:order-1">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
          <span class="inline-flex items-center gap-2 font-label text-[10px] font-bold uppercase tracking-[0.2em] text-primary">
            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
            Article
          </span>
          <span class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">{card.listDate}</span>
          <span class="w-1 h-1 bg-outline-variant rounded-full"></span>
          <span class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">{card.wordCount}</span>
        </div>
        <h3 class="font-headline font-bold text-2xl md:text-3xl tracking-tight text-on-surface group-hover:underline underline-offset-8 transition-all">
          <a class="hover:opacity-80 transition-opacity" href={card.href}>{card.title}</a>
        </h3>
        <p class="serif-text text-on-surface-variant text-lg leading-relaxed max-w-2xl">{card.excerpt}</p>
        <div class="flex space-x-2 pt-2">
          {card.tags.map((tag) => (
            <span class="px-4 py-1.5 border border-surface-container-highest text-[9px] font-bold uppercase tracking-widest rounded-full text-on-surface-variant">{tag}</span>
          ))}
        </div>
      </div>
      <div class="w-full md:w-48 h-48 bg-surface-container shrink-0 order-1 md:order-2 overflow-hidden">
        <img
          alt={card.title}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          decoding="async"
          height="192"
          loading="lazy"
          src={card.thumbnail}
          width="192"
        />
      </div>
    </div>
  ) : (
    <div class="flex flex-col md:flex-row md:items-start gap-8">
      <div class="flex-1 space-y-4">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
          <span class="inline-flex items-center gap-2 font-label text-[10px] font-bold uppercase tracking-[0.2em] text-primary">
            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
            Article
          </span>
          <span class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">{card.listDate}</span>
          <span class="w-1 h-1 bg-outline-variant rounded-full"></span>
          <span class="font-label text-[10px] uppercase tracking-[0.2em] text-outline">{card.wordCount}</span>
        </div>
        <h3 class="font-headline font-bold text-2xl md:text-3xl tracking-tight text-on-surface group-hover:underline underline-offset-8 transition-all">
          <a href={card.href}>{card.title}</a>
        </h3>
        <p class="serif-text text-on-surface-variant text-lg leading-relaxed max-w-2xl">{card.excerpt}</p>
        <div class="flex space-x-2 pt-2">
          {card.tags.map((tag) => (
            <span class="px-4 py-1.5 border border-surface-container-highest text-[9px] font-bold uppercase tracking-widest rounded-full text-on-surface-variant">{tag}</span>
          ))}
        </div>
      </div>
    </div>
  )}
</article>
