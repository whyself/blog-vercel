---
const {
  base = import.meta.env.BASE_URL,
  alt = "Hero background",
  title = "",
  profileOverlay = false,
} = Astro.props as {
  base?: string;
  alt?: string;
  title?: string;
  profileOverlay?: boolean;
};

const lightAvifSet = `${base}images/hero/blog-hero-light-768.avif 768w, ${base}images/hero/blog-hero-light-1280.avif 1280w, ${base}images/hero/blog-hero-light-1920.avif 1920w`;
const lightWebpSet = `${base}images/hero/blog-hero-light-768.webp 768w, ${base}images/hero/blog-hero-light-1280.webp 1280w, ${base}images/hero/blog-hero-light-1920.webp 1920w`;
const darkAvifSet = `${base}images/hero/blog-hero-dark-768.avif 768w, ${base}images/hero/blog-hero-dark-1280.avif 1280w, ${base}images/hero/blog-hero-dark-1920.avif 1920w`;
const darkWebpSet = `${base}images/hero/blog-hero-dark-768.webp 768w, ${base}images/hero/blog-hero-dark-1280.webp 1280w, ${base}images/hero/blog-hero-dark-1920.webp 1920w`;
const transparentPixel = "data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=";
const lightLqip = "data:image/webp;base64,UklGRrwAAABXRUJQVlA4ILAAAABQBgCdASooABcAPt1an04opSKiNUwBEBuJbACsOUFVvkCKkBTtMdxmwDLOfhACGFmxX1uvOCvh7mXAAAD+VHLl3hmY7XoUpXmPrwcLYtU9BmLeX1iyW1fCVZ3SihpQV0i0kmLe4WTI3ujFXmu1X44bQ7X7mEGaqHsmwlfTEB4cOB4vZ7dcatFs3qg/k9XldTsd1zZzCoANlXDr6HUE47t7EwqqDPK663uoLkdWI76AAA==";
const darkLqip = "data:image/webp;base64,UklGRqIAAABXRUJQVlA4IJYAAABQBgCdASooABcAPvVgqU6qpSOiMBqqqVAeiWIAp0d2xeALvfhKVM2cbuGHJPQ8NdiEQdEWKJuZQebpgAD3H9AGMKwVMcjgJqJOpHBmsPDXHjBLvGXx7LwOjb8pjDSkduUtFgtlrCMEQAhQI/wJ0Strse3+iNwElO/meMC5QAqJ9uu7/8bqlyj0YxOt1CBfA5v2eCwAAAA=";
---

<section class="w-full relative overflow-hidden bg-surface-dim" data-hero>
  <div class="hero-layer hero-layer--light relative w-full" data-hero-layer="light">
    <div
      class="absolute inset-0 bg-center bg-cover scale-105 blur-xl transition-opacity duration-500"
      data-hero-lqip="light"
      style={`background-image: url('${lightLqip}')`}
    ></div>
    <picture
      class:list={[profileOverlay && "block h-[var(--mobile-hero-h)] lg:h-auto"]}
      data-hero-picture="light"
    >
      <source
        data-srcset={lightAvifSet}
        sizes="100vw"
        srcset={transparentPixel}
        type="image/avif"
      />
      <source
        data-srcset={lightWebpSet}
        sizes="100vw"
        srcset={transparentPixel}
        type="image/webp"
      />
      <img
        alt={alt}
        class:list={[
          "relative block w-full transition-opacity duration-500 opacity-0",
          profileOverlay ? "h-full object-cover lg:h-auto" : "h-auto",
        ]}
        data-src={`${base}images/hero/blog-hero-light-1280.webp`}
        decoding="async"
        fetchpriority="high"
        height="1536"
        id="hero-main-image"
        loading="eager"
        sizes="100vw"
        src={transparentPixel}
        width="2722"
      />
    </picture>
  </div>

  <div class="hero-layer hero-layer--dark absolute inset-0 w-full h-full" data-hero-layer="dark">
    <div
      class="absolute inset-0 bg-center bg-cover scale-105 blur-xl transition-opacity duration-500"
      data-hero-lqip="dark"
      style={`background-image: url('${darkLqip}')`}
    ></div>
    <picture
      class="block w-full h-full"
      data-hero-picture="dark"
    >
      <source
        data-srcset={darkAvifSet}
        sizes="100vw"
        srcset={transparentPixel}
        type="image/avif"
      />
      <source
        data-srcset={darkWebpSet}
        sizes="100vw"
        srcset={transparentPixel}
        type="image/webp"
      />
      <img
        alt={alt}
        class="relative block w-full h-full object-cover transition-opacity duration-500 opacity-0"
        data-src={`${base}images/hero/blog-hero-dark-1280.webp`}
        decoding="async"
        fetchpriority="auto"
        height="1536"
        loading="eager"
        sizes="100vw"
        src={transparentPixel}
        width="2722"
      />
    </picture>
  </div>

  <div class="absolute inset-0 z-[1] bg-zinc-950/10 pointer-events-none"></div>
  {profileOverlay && (
    <div class="hero-profile-wash pointer-events-none absolute inset-0 z-[2] lg:hidden" aria-hidden="true"></div>
  )}
  <div class="hero-fade absolute inset-x-0 bottom-0 z-[3] h-28 md:h-44 pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 z-[4] w-full p-8 md:p-12">
    {title && (
      <h1
        class="font-load-hidden text-5xl md:text-8xl font-semibold text-on-surface leading-none"
        style="font-family: 'Segoe Script', cursive;"
      >
        {title}
      </h1>
    )}
  </div>
</section>

<style>
  .hero-layer--light {
    opacity: 1;
  }

  .hero-layer--dark {
    opacity: 0;
    pointer-events: none;
  }

  :global(html.dark) .hero-layer--light {
    opacity: 0;
    pointer-events: none;
  }

  :global(html.dark) .hero-layer--dark {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-fade {
    background: linear-gradient(
      to top,
      rgba(249, 249, 249, 1) 0%,
      rgba(249, 249, 249, 0.86) 24%,
      rgba(249, 249, 249, 0.42) 62%,
      rgba(249, 249, 249, 0) 100%
    );
  }

  :global(html.dark) .hero-fade {
    background: linear-gradient(
      to top,
      rgba(26, 26, 26, 1) 0%,
      rgba(26, 26, 26, 0.88) 24%,
      rgba(26, 26, 26, 0.46) 62%,
      rgba(26, 26, 26, 0) 100%
    );
  }

  /* Soft page-coloured haze under the mobile profile so the photo never
     fights the text. Kept radial so it blends into the sky instead of
     looking like a card. */
  .hero-profile-wash {
    background: radial-gradient(
      ellipse 64% 84% at 100% 82%,
      rgba(249, 249, 249, 0.95) 0%,
      rgba(249, 249, 249, 0.84) 34%,
      rgba(249, 249, 249, 0.52) 62%,
      rgba(249, 249, 249, 0.2) 82%,
      rgba(249, 249, 249, 0) 100%
    );
  }

  :global(html.dark) .hero-profile-wash {
    background: radial-gradient(
      ellipse 64% 84% at 100% 82%,
      rgba(26, 26, 26, 0.96) 0%,
      rgba(26, 26, 26, 0.86) 34%,
      rgba(26, 26, 26, 0.58) 62%,
      rgba(26, 26, 26, 0.24) 82%,
      rgba(26, 26, 26, 0) 100%
    );
  }
</style>

<script is:inline>
  (() => {
    const heroRoot = document.querySelector("[data-hero]");
    if (!heroRoot) return;

    const layers = {
      light: heroRoot.querySelector('[data-hero-layer="light"]'),
      dark: heroRoot.querySelector('[data-hero-layer="dark"]'),
    };

    const activated = { light: false, dark: false };

    const revealLayer = (layer) => {
      const img = layer?.querySelector("img");
      const lqip = layer?.querySelector("[data-hero-lqip]");
      if (img) {
        img.classList.remove("opacity-0");
        img.classList.add("opacity-100");
      }
      if (lqip) {
        lqip.classList.remove("opacity-100");
        lqip.classList.add("opacity-0");
      }
    };

    const activateLayer = (theme) => {
      if (activated[theme]) return;
      const layer = layers[theme];
      if (!layer) return;
      activated[theme] = true;

      const sources = Array.from(layer.querySelectorAll("source"));
      const img = layer.querySelector("img");
      if (!img) return;

      const markReady = () => {
        if (img.currentSrc && !img.currentSrc.startsWith("data:image/gif")) {
          revealLayer(layer);
        } else if (img.naturalWidth > 1) {
          revealLayer(layer);
        }
      };

      img.addEventListener("load", markReady);
      sources.forEach((source) => {
        if (source.dataset.srcset) source.srcset = source.dataset.srcset;
      });
      if (img.dataset.src) img.src = img.dataset.src;

      if (img.complete) markReady();
    };

    const getTheme = () => (document.documentElement.classList.contains("dark") ? "dark" : "light");

    const initialTheme = getTheme();
    const alternateTheme = initialTheme === "dark" ? "light" : "dark";
    let preloadTriggered = false;

    const triggerAlternatePreload = () => {
      if (preloadTriggered) return;
      preloadTriggered = true;
      activateLayer(alternateTheme);
    };

    const initialLayer = layers[initialTheme];
    const initialImg = initialLayer?.querySelector("img");
    if (initialImg) {
      initialImg.addEventListener("load", () => {
        if (initialImg.currentSrc && !initialImg.currentSrc.startsWith("data:image/gif")) {
          triggerAlternatePreload();
        }
      });
    }

    activateLayer(initialTheme);
    window.setTimeout(triggerAlternatePreload, 500);

    document.addEventListener("themechange", () => {
      activateLayer(getTheme());
    });
  })();
</script>
